# Neon Postgres connection (Dashboard -> Connection string)
# sslmode=require is mandatory.
DATABASE_URL=postgresql://[YOUR-USER]:[YOUR-PASSWORD]@[YOUR-PROJECT].neon.tech/neondb?sslmode=require

# OpenAQ API key (openaq.org account -> API keys)
OPENAQ_API_KEY=your_openaq_api_key_here

# Local dev only (docker-compose), not used in production
POSTGRES_USER=joshua
POSTGRES_PASSWORD=change_me
POSTGRES_DB=atlas_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
