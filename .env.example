# Supabase Postgres connection (Project Settings -> Database -> Connection string -> URI)
# Use the "Session pooler" or direct connection string; sslmode=require is mandatory.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# OpenAQ API key (openaq.org account -> API keys)
OPENAQ_API_KEY=your_openaq_api_key_here

# Local dev only (docker-compose), not used in production
POSTGRES_USER=joshua
POSTGRES_PASSWORD=change_me
POSTGRES_DB=atlas_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
